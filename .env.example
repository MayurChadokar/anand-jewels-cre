# Default DB: data/cre.db. Use an absolute path if overriding.
# CRE_DATABASE_URL=sqlite:///C:/path/to/cre-project/data/cre.db
# Local default creates a persistent, private key in data/session.key.
# CRE_SECRET_KEY=replace-with-a-long-random-secret
CRE_SESSION_COOKIE=anand_cre_session
CRE_COOKIE_SECURE=false

# Feedback integration. Keep real secrets only in .env or the deployment secret store.
KIT19_WHATSAPP_URL=https://services.kit19.com/IMS/Whatsapp/Template
KIT19_WHATSAPP_KEY=replace-with-real-key
KIT19_WHATSAPP_USERNAME=replace-with-username
FEEDBACK_PUBLIC_URL=https://anandjewels.com/feedback.html?utm_src=cre
ANAND_INTEGRATION_KEY=replace-with-a-long-random-secret
# Automatically queue the feedback WhatsApp after a walk-in is saved.
FEEDBACK_AUTO_SEND=true
