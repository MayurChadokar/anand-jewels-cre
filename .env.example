# Default DB: data/cre.db. Use an absolute path if overriding.
# CRE_DATABASE_URL=sqlite:///C:/path/to/cre-project/data/cre.db
# Local default creates a persistent, private key in data/session.key.
# CRE_SECRET_KEY=replace-with-a-long-random-secret
CRE_SESSION_COOKIE=anand_cre_session
CRE_COOKIE_SECURE=false
